{
  "name": "misiachnyi-korzh",
  "private": true,
  "version": "0.1.0",
  "description": "Місячний Корж — магічна кондитерська для котів-чарівників",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app:sync": "npm run build && cap sync",
    "app:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#0c0824\" --splashBackgroundColor \"#0c0824\" --splashBackgroundColorDark \"#0c0824\""
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "subset-font": "^2.9.0",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.1.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1"
  }
}
