    { "name": "game", "runtimeExecutable": "powershell", "runtimeArgs": ["-NoProfile","-Command","$l=New-Object System.Net.HttpListener;$l.Prefixes.Add('http://localhost:8765/');$l.Start();while($l.IsListening){$c=$l.GetContext();$p=Join-Path (Get-Location) 'index.html';$b=[IO.File]::ReadAllBytes($p);$c.Response.ContentType='text/html; charset=utf-8';$c.Response.OutputStream.Write($b,0,$b.Length);$c.Response.Close()}"], "port": 8765 }
